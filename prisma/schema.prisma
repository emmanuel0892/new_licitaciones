model licitacion_firmas {
  id             Int        @id @default(autoincrement())
  licitacion_id  Int
  numero_paso    Int
  firma_key      String     @db.VarChar(100)
  firma_label    String     @db.VarChar(150)
  user_id        String     @db.VarChar(30)
  created_at     DateTime   @default(now()) @db.Timestamp(0)
  firma_base64   String?    @db.LongText
  licitaciones   Licitacion @relation(fields: [licitacion_id], references: [id], onDelete: Cascade, map: "fk_licitacion_firmas_licitacion")
  users          User       @relation(fields: [user_id], references: [id], map: "fk_licitacion_firmas_user")

  @@unique([licitacion_id, numero_paso, firma_key], map: "uq_licitacion_paso_firma")
  @@index([licitacion_id], map: "idx_licitacion_firmas_licitacion_id")
  @@index([user_id], map: "idx_licitacion_firmas_user_id")
}

model permisos {
  id             Int              @id @default(autoincrement())
  codigo         String           @unique(map: "codigo") @db.VarChar(100)
  nombre         String           @db.VarChar(150)
  descripcion    String?          @db.Text
  categoria      String           @db.VarChar(100)
  created_at     DateTime         @default(now()) @db.Timestamp(0)
  updated_at     DateTime         @default(now()) @db.Timestamp(0)
  roles_permisos roles_permisos[]
}

model roles_permisos {
  role_id    String   @db.VarChar(36)
  permiso_id Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  permisos   permisos @relation(fields: [permiso_id], references: [id], onDelete: Cascade, map: "fk_roles_permisos_permiso")
  roles      roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "fk_roles_permisos_role")

  @@id([role_id, permiso_id])
  @@index([permiso_id], map: "idx_roles_permisos_permiso_id")
  @@index([role_id], map: "idx_roles_permisos_role_id")
}

// ─── Valor agregado · Fase 1: Notificaciones por correo (aditivo) ───────────
// Tablas independientes (sin FK hacia modelos existentes) para no alterar nada.

model NotificacionEnviada {
  id         Int      @id @default(autoincrement())
  usuarioId  String   @map("usuario_id") @db.VarChar(36)
  tipo       String   @db.VarChar(30)
  referencia String   @db.VarChar(150)
  canal      String   @default("email") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([usuarioId, tipo, referencia, canal], map: "uq_notificacion_idempotente")
  @@index([usuarioId], map: "idx_notificacion_usuario")
  @@map("notificacion_enviada")
}

model PreferenciaNotificacion {
  usuarioId       String   @id @map("usuario_id") @db.VarChar(36)
  emailPlazos     Boolean  @default(true) @map("email_plazos")
  emailConsumo    Boolean  @default(true) @map("email_consumo")
  emailAsignacion Boolean  @default(true) @map("email_asignacion")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("preferencia_notificacion")
}
